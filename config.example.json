{
  "db_path": "~/.helicon/helicon.db",
  "qwen_api_key": "",
  "openrouter_api_key": "",
  "embeddings": {
    "api_key": "",
    "base_url": "https://openrouter.ai/api/v1",
    "model": "openai/text-embedding-3-small",
    "dim": 1536
  },
  "qwen_base_url": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
  "connectors": {
    "claude-code": {
      "enabled": true,
      "jsonl_dir": "~/.claude/projects",
      "memory_dir": "~/.claude/projects/-Users-you/memory",
      "sessions_index": "~/.claude/projects/-Users-you/sessions-index.json"
    },
    "obsidian": {
      "enabled": true,
      "vault_path": "~/Documents/MyVault",
      "max_depth": 3,
      "skip_dirs": [".obsidian", ".trash"]
    },
    "git": {
      "enabled": true,
      "repos_dir": "~/projects",
      "max_commits": 30
    },
    "skills": {
      "enabled": true,
      "skill_roots": ["~/.claude/skills"]
    },
    "chatgpt": {
      "enabled": false,
      "export_path": "~/Downloads/chatgpt-export/conversations.json"
    },
    "cursor": {
      "enabled": false,
      "memory_dir": "~/.cursor"
    },
    "cursor-cloud": {
      "enabled": false,
      "export_dir": "~/Downloads/cursor-cloud-agent-transcripts",
      "include_text": false,
      "max_text_chars": 6000
    },
    "agent-rules": {
      "enabled": true,
      "repos_dir": "~/projects",
      "repos": [],
      "max_repos": 50
    }
  },
  "aliases": {
    "_comment": "R4's code arm: where a declared dead name may be searched for as EXECUTABLE code. Unset means the arm does not run and the exam reports it unmeasured — it never falls back to scanning your home directory. Falls back to connectors.git.repos_dir when omitted. The checkout Helicon itself runs from is always excluded.",
    "repos_dir": "~/projects"
  },
  "forgetting": {
    "stability": {
      "code": 7.0,
      "file_created": 14.0,
      "decision": 30.0,
      "draft": 10.0,
      "pattern": 60.0,
      "memory": 45.0
    },
    "prune_threshold": 0.05
  },
  "audit": {
    "temporal_stale_days": 7,
    "min_spin_sessions": 4,
    "kill_prediction_days": 30,
    "kill_prediction_threshold": 0.9
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8420,
    "password": ""
  }
}
